{
  "name": "@snapgauge/web",
  "private": true,
  "version": "0.0.0",
  "description": "Next.js demo site (/, /demo, /live, /board) — SPEC §4. Runs the real snapgauge engine offline in a Web Worker and, live, an SSRF-guarded read-only audit of a visitor-supplied MCP server URL.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",

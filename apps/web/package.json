    "e2e:smoke": "node e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "snapgauge": "workspace:*",
    "@snapgauge/fixtures": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}

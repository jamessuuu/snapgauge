{
  "name": "snapgauge-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "eval": "vitest run --project eval",
    "docs:rules": "pnpm --filter snapgauge build && node scripts/generate-rules.mjs",
    "ci:pack-check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@snapgauge/fixtures": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "snapgauge": "workspace:*",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  }
}

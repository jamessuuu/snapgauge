{
  "name": "snapgauge",
  "version": "0.1.0-alpha.0",
  "description": "Contract tests for MCP servers: record a snapshot of a server's schema and observable behavior; fail CI when the next version moves.",
  "license": "MIT",
  "author": "James Lorenz Santos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamessuuu/snapgauge.git",
    "directory": "packages/snapgauge"
  },
  "homepage": "https://github.com/jamessuuu/snapgauge#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "snapgauge": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bin": "./src/cli/run.ts",
    "./node": "./src/node/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./bin": {
        "types": "./dist/cli/run.d.ts",
        "default": "./dist/cli/run.js"
      },
      "./node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "undici": "^7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@snapgauge/fixtures": "workspace:*"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "contract-testing",
    "snapshot-testing",
    "schema-drift",
    "ci"
  ]
}
